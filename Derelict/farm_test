-- [PHẦN 5: LUỒNG ĐỒNG BỘ CHÍNH NÂNG CẤP v7.6]
-- -----------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local TargetFolder = workspace:FindFirstChild("InstancedGeometry") and workspace.InstancedGeometry:FindFirstChild("Humanoids")
    local character = LocalPlayer.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    local myHumanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if TargetFolder and myRoot and myHumanoid then
        local myPos = myRoot.Position
        
        updateLockEngine(myPos, character, TargetFolder)
        
        -- =============================================================================
        -- [🎯 BẢN HOÀN THIỆN v7.9] LUỒNG 2: KHÓA BẬT GỐC KHI QUÁI <= 0 + FIX LỖI NẰM BẸP DÍ
        -- =============================================================================
        if _G.AutoFarmHoverToggle then
            -- Ép trạng thái chạy liên tục để mở khóa Cung/Trượng
            myHumanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            myHumanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            if myHumanoid:GetState() ~= Enum.HumanoidStateType.Running then
                myHumanoid:ChangeState(Enum.HumanoidStateType.Running)
            end

            -- Noclip xuyên địa hình
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            
            -- Kiểm tra mục tiêu cũ xem có hợp lệ và còn máu hay không
            local isTargetValid = false
            if _G.AutoFarmTarget and _G.AutoFarmTarget.Parent and _G.AutoFarmTarget:FindFirstChild("HumanoidRootPart") then
                local tHumanoid = _G.AutoFarmTarget:FindFirstChildOfClass("Humanoid")
                -- QUY CHUẨN MỚI: Máu phải lớn hơn 0 và không nằm trong danh sách đen xác chết
                if tHumanoid and tHumanoid.Health > 0 and not _G.BlacklistedCorpses[_G.AutoFarmTarget] then
                    isTargetValid = true
                else
                    -- Nếu quái hết máu, cho vào danh sách đen ngay để loại bỏ hoàn toàn
                    _G.BlacklistedCorpses[_G.AutoFarmTarget] = true
                end
            end

            -- Nếu quái die, lập tức hủy mục tiêu và quét tìm con khác sống khỏe mạnh
            if not isTargetValid then
                _G.AutoFarmTarget = nil
                -- Quét tìm quái mới sống 100% bằng hàm quét độc lập có loại xác chết
                _G.AutoFarmTarget = getClosestMonster360(myPos, character, TargetFolder)
            end
            
            FakeFloor.CanCollide = true
            local nextTargetPosition = nil
            local lookAtPosition = nil
            
            -- Nếu có mục tiêu SỐNG
            if _G.AutoFarmTarget and _G.AutoFarmTarget:FindFirstChild("HumanoidRootPart") then
                local tRoot = _G.AutoFarmTarget.HumanoidRootPart
                local offsetCFrame = tRoot.CFrame * CFrame.new(0, _G.HoverHeight, 2)
                nextTargetPosition = offsetCFrame.Position
                lookAtPosition = tRoot.Position
            end
            
            if nextTargetPosition and lookAtPosition then
                local moveVector = nextTargetPosition - myPos
                local distance = moveVector.Magnitude
                
                if distance < 1.5 then
                    -- Đã đến điểm an toàn -> Neo cứng người chống giật lắc khi quái di chuyển loăng quăng
                    myRoot.Velocity = Vector3.new(0, 0, 0)
                    myRoot.CFrame = CFrame.lookAt(myPos, lookAtPosition)
                    myRoot.Anchored = true 
                    
                    FakeFloor.Position = myPos + Vector3.new(0, -3.1, 0)
                    FakeFloor.Orientation = Vector3.new(0, 0, 0)
                else
                    -- Quái ở xa -> Mở neo để lướt tới cực nhanh
                    myRoot.Anchored = false
                    local clampedMove = moveVector.Unit * math.min(distance, _G.MaxFlyStep)
                    local nextStepPos = myPos + clampedMove
                    
                    myRoot.CFrame = CFrame.lookAt(nextStepPos, lookAtPosition)
                    myRoot.Velocity = Vector3.new(0, 0, 0)
                    
                    FakeFloor.Position = nextStepPos + Vector3.new(0, -3.1, 0)
                    FakeFloor.Orientation = Vector3.new(0, 0, 0)
                end
            else
                -- 🚀 KHÓA LƠ LỬNG TUYỆT ĐỐI KHI QUÁI DIE: Đóng băng ngay lập tức tại vị trí hiện tại, kệ cái xác rơi xuống!
                myRoot.Velocity = Vector3.new(0, 0, 0)
                myRoot.Anchored = true 
                
                FakeFloor.Position = myPos + Vector3.new(0, -3.1, 0)
                FakeFloor.Orientation = Vector3.new(0, 0, 0)
            end
        else
            -- 🚀 XỬ LÝ ĐÁP ĐẤT AN TOÀN (FIX LỖI NẰM BẸP DÍ 3-5 GIÂY)
            if myRoot.Anchored then 
                myRoot.Anchored = false 
            end
            
            if FakeFloor.CanCollide then
                FakeFloor.CanCollide = false
                FakeFloor.Position = Vector3.new(0, -1000, 0)
                
                -- Ép nhân vật vào trạng thái Đứng dậy ngay lập tức thay vì thả rơi tự do rơi tự do
                myHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                
                -- Chờ 1 khung hình nhỏ rồi mới trả quyền vật lý cho game để không bị sốc Ragdoll
                task.defer(function()
                    myHumanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    myHumanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                    for _, part in pairs(character:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = true end
                    end
                end)
                
                _G.AutoFarmTarget = nil
                _G.BlacklistedCorpses = {} -- Clear bộ nhớ danh sách đen khi tắt farm
            end
        end
        
        -- LUỒNG 3: ĐỒ HỌA ESP DIỆN RỘNG (GIỮ NGUYÊN)
        if _G.FastBotToggle then
            for _, obj in pairs(TargetFolder:GetChildren()) do
                if obj:IsA("Model") and not NPC_BLACK_LIST[obj.Name] and obj ~= character and not Players:GetPlayerFromCharacter(obj) then
                    local monsterRoot = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
                    local humanoid = obj:FindFirstChildOfClass("Humanoid")
                    if monsterRoot and humanoid and humanoid.Health > 0 then
                        local distance = (myPos - monsterRoot.Position).Magnitude
                        if distance < _G.MaxFastDistance and isBeforeCamera(monsterRoot.Position) then
                            drawOverheadUI(obj)
                            if _G.LaserToggle then drawLaserLine(obj, myPos) else
                                if obj:FindFirstChild("FastLaserBeam") then obj.FastLaserBeam:Destroy() end
                                local originPart = LaserFolder:FindFirstChild("Origin_" .. obj:GetDebugId())
                                if originPart then originPart:Destroy() end
                            end
                        else clearVisuals(obj) end
                    else clearVisuals(obj) end
                end
            end
        else
            for _, mob in pairs(TargetFolder:GetChildren()) do clearVisuals(mob) end
        end
    else
        LockHighlight.Adornee = nil
        _G.CurrentTarget = nil
        _G.AutoFarmTarget = nil
        FakeFloor.CanCollide = false
    end
end)
