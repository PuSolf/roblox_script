local function isBeforeCamera(targetPosition)
    local _, onScreen = Camera:WorldToViewportPoint(targetPosition)
    return onScreen
end

local function drawOverheadUI(model)
    if model:FindFirstChild("MobESP_Overhead") then return end
    local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local bbgui = Instance.new("BillboardGui")
    bbgui.Name = "MobESP_Overhead"; bbgui.Size = UDim2.new(0, 160, 0, 28); bbgui.AlwaysOnTop = true
    bbgui.ExtentsOffset = Vector3.new(0, (model:GetExtentsSize().Y / 2) + 0.8, 0)
    bbgui.MaxDistance = _G.MaxFastDistance; bbgui.Adornee = root; bbgui.Parent = model
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0); nameLabel.BackgroundTransparency = 1
    nameLabel.Text = model.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 230, 0) 
    nameLabel.TextSize = 12; nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextStrokeTransparency = 0.1; nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Parent = bbgui
end

local function drawLaserLine(model, myPos)
    local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local originPart = LaserFolder:FindFirstChild("Origin_" .. model:GetDebugId())
    if not originPart then
        originPart = Instance.new("Part")
        originPart.Name = "Origin_" .. model:GetDebugId()
        originPart.Size = Vector3.new(0.1, 0.1, 0.1)
        originPart.Transparency = 1; originPart.CanCollide = false; originPart.Anchored = true
        local att0 = Instance.new("Attachment")
        att0.Name = "OriginAttachment"; att0.Parent = originPart
        originPart.Parent = LaserFolder
    end
    originPart.Position = myPos - Vector3.new(0, 0.5, 0)
    
    local targetAttachment = root:FindFirstChild("LaserTargetAttachment")
    if not targetAttachment then
        targetAttachment = Instance.new("Attachment"); targetAttachment.Name = "LaserTargetAttachment"
        targetAttachment.Position = Vector3.new(0, model:GetExtentsSize().Y * 0.15, 0)
        targetAttachment.Parent = root
    end
    
    local beam = model:FindFirstChild("FastLaserBeam")
    if not beam then
        beam = Instance.new("Beam"); beam.Name = "FastLaserBeam"; beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0)) 
        beam.Width0 = 0.04; beam.Width1 = 0.04; beam.FaceCamera = true
        beam.Attachment0 = originPart.OriginAttachment; beam.Attachment1 = targetAttachment; beam.Parent = model
    end
end

local function clearVisuals(model)
    if not model then return end
    if model:FindFirstChild("MobESP_Overhead") then model.MobESP_Overhead:Destroy() end
    if model:FindFirstChild("FastLaserBeam") then model.FastLaserBeam:Destroy() end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if root and root:FindFirstChild("LaserTargetAttachment") then root.LaserTargetAttachment:Destroy() end
    local originPart = LaserFolder:FindFirstChild("Origin_" .. model:GetDebugId())
    if originPart then originPart:Destroy() end
end

-- -----------------------------------------------------------------------------
-- [PHẦN 3: ENGINE QUÉT QUÁI 360 ĐỘ ĐỘC LẬP]
-- -----------------------------------------------------------------------------
local function validateTarget(model, myPos)
    if not model or not model.Parent then return false end
    local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return false end
    local distance = (myPos - root.Position).Magnitude
    if distance > _G.MaxFastDistance or not isBeforeCamera(root.Position) then return false end
    return true
end

local function scanNewTarget(myPos, character, TargetFolder)
    local closestMonster = nil; local shortestDistance = _G.MaxFastDistance
    for _, obj in pairs(TargetFolder:GetChildren()) do
        if obj:IsA("Model") and not NPC_BLACK_LIST[obj.Name] and obj ~= character and not Players:GetPlayerFromCharacter(obj) then
            local monsterRoot = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if monsterRoot and humanoid and humanoid.Health > 0 and not _G.BlacklistedCorpses[obj] then
                local distance = (myPos - monsterRoot.Position).Magnitude
                if distance < shortestDistance and isBeforeCamera(monsterRoot.Position) then
                    shortestDistance = distance; closestMonster = obj
                end
            end
        end
    end
    return closestMonster
end

local function updateLockEngine(myPos, character, TargetFolder)
    if not _G.LockEngineToggle then _G.CurrentTarget = nil; LockHighlight.Adornee = nil; return end
    if _G.CurrentTarget and validateTarget(_G.CurrentTarget, myPos) then LockHighlight.Adornee = _G.CurrentTarget; return end
    _G.CurrentTarget = nil; LockHighlight.Adornee = nil
    local newTarget = scanNewTarget(myPos, character, TargetFolder)
    if newTarget then _G.CurrentTarget = newTarget; LockHighlight.Adornee = newTarget end
end

local function getClosestMonster360(myPos, character, TargetFolder)
    local closestMonster = nil; local shortestDistance = math.huge
    for _, obj in pairs(TargetFolder:GetChildren()) do
        if obj:IsA("Model") and not NPC_BLACK_LIST[obj.Name] and obj ~= character and not Players:GetPlayerFromCharacter(obj) then
            local monsterRoot = obj:FindFirstChild("HumanoidRootPart")
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if monsterRoot and humanoid and humanoid.Health > 0 and not _G.BlacklistedCorpses[obj] then
                local distance = (myPos - monsterRoot.Position).Magnitude
                if distance < shortestDistance and distance <= _G.MaxFastDistance then
                    shortestDistance = distance; closestMonster = obj
                end
            end
        end
    end
    return closestMonster
end

